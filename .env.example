# Every variable LeaderPact reads, with no secrets. Copy to .env.local for local work.

# Supabase: the project URL and its publishable (anon) key. Neither is a secret: the key ships to the
# browser by design, and RLS is what protects the data. Both are inlined at build time, so a change
# needs a rebuild. Hosted project: leaderpact, ref tgxjbshdjwoemsmrtkzw.
NEXT_PUBLIC_SUPABASE_URL=https://tgxjbshdjwoemsmrtkzw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Build into another directory, so a verification build never overwrites the dev server's.
# NEXT_DIST_DIR=.next-build

# Playwright: the port `next start` listens on for the flows, and a Chromium already on disk
# (a cloud session ships one at /opt/pw-browsers/chromium; CI installs its own).
# E2E_PORT=3100
# PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium

# The SQL suites and the audit: a LOCAL database only (scripts/qa/local-pg.sh prints one).
# DATABASE_URL=postgresql://postgres@127.0.0.1:54399/postgres
# AUDIT_DB=postgresql://postgres:postgres@127.0.0.1:54322/postgres
